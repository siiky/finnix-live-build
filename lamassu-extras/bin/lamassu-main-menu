#!/usr/bin/env sh
# shellcheck disable=SC3043

lamassu_bin_dir="$(dirname "$0")"

XUBUNTU_IMAGE="$(realpath -e "${lamassu_bin_dir}/../xubuntu.img.gz")"
XUBUNTU_IMAGE_ENV="$(realpath -e "${lamassu_bin_dir}/../xubuntu.env")"
LMX_RELEASE_NUMBER="$(grep '^RELEASE_NUMBER=' "${XUBUNTU_IMAGE_ENV}" | cut -d= --complement -f1)"; export LMX_RELEASE_NUMBER
LMX_MACHINE_VERSION="$(grep '^MACHINE_VERSION=' "${XUBUNTU_IMAGE_ENV}" | cut -d= --complement -f1)"; export LMX_MACHINE_VERSION

UBILINUX_IMAGE="$(realpath -e "${lamassu_bin_dir}/../ubilinux.img.gz")"
UBILINUX_IMAGE_ENV="$(realpath -e "${lamassu_bin_dir}/../ubilinux.env")"
UBILINUX_RELEASE_NUMBER="$(grep '^RELEASE_NUMBER=' "${UBILINUX_IMAGE_ENV}" | cut -d= --complement -f1)"; export UBILINUX_RELEASE_NUMBER
UBILINUX_MACHINE_VERSION="$(grep '^MACHINE_VERSION=' "${UBILINUX_IMAGE_ENV}" | cut -d= --complement -f1)"; export UBILINUX_MACHINE_VERSION

TUI_OK=0

tui() {
	whiptail "$@" 3>&2 2>&1 1>&3 3>&-
}

tui_main_menu() {
	local menumsg='What do you wish to do?  If you wish to install the Lamassu software on a machine, but are unsure on how to proceed, choose the "guided installer".'
	if [ "${LMX_RELEASE_NUMBER}" != '' ]; then menumsg="${menumsg}\nl-m-x release number: ${LMX_RELEASE_NUMBER}"; fi
	if [ "${LMX_MACHINE_VERSION}" != '' ]; then menumsg="${menumsg}\nLamassu machine version: ${LMX_MACHINE_VERSION}"; fi
	tui --title 'Lamassu installer main menu' \
		--menu "${menumsg}" 0 0 0 \
		guided 'Launch the Lamassu guided installer' \
		shell 'Start a Bash shell' \
		shutdown 'Shut the machine down' \
		reboot 'Reboot the machine'
}

do_guided() {
	"${lamassu_bin_dir}"/flash-image.sh guided "${XUBUNTU_IMAGE}" "${UBILINUX_IMAGE}"
}

do_shell() {
	/bin/bash --norc --noprofile
}

do_shutdown() {
	shutdown -h now
}

do_reboot() {
	reboot
}

while true; do
	action="$(tui_main_menu)"
	case $? in
		"$TUI_OK") "do_${action}";;
		*);;
	esac
done
