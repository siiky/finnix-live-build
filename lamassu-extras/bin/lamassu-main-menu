#!/usr/bin/env sh
# shellcheck disable=SC3043

lamassu_bin_dir="$(dirname "$0")"

IMAGE="$(realpath -e "${lamassu_bin_dir}/../ssuos.wic.lz")"
#IMAGE_ENV="$(realpath -e "${lamassu_bin_dir}/../ssuos.env")"
#RELEASE_NUMBER="$(grep '^RELEASE_NUMBER=' "${IMAGE_ENV}" | cut -d= --complement -f1)"; export RELEASE_NUMBER
#MACHINE_VERSION="$(grep '^MACHINE_VERSION=' "${IMAGE_ENV}" | cut -d= --complement -f1)"; export MACHINE_VERSION

TUI_OK=0

tui() {
	whiptail "$@" 3>&2 2>&1 1>&3 3>&-
}

tui_main_menu() {
	local menumsg='What do you wish to do?  If you wish to install the Lamassu software on a machine, but are unsure on how to proceed, choose the "guided installer".'
	if [ "${RELEASE_NUMBER}" != '' ]; then menumsg="${menumsg}\nl-m-x release number: ${RELEASE_NUMBER}"; fi
	if [ "${MACHINE_VERSION}" != '' ]; then menumsg="${menumsg}\nLamassu machine version: ${MACHINE_VERSION}"; fi
	tui --title 'Lamassu installer main menu' \
		--menu "${menumsg}" 0 0 0 \
		guided 'Launch the Lamassu guided installer' \
		shell 'Start a Bash shell' \
		shutdown 'Shut the machine down' \
		reboot 'Reboot the machine'
}

do_guided() {
	"${lamassu_bin_dir}"/flash-image.sh guided "${IMAGE}"
}

do_shell() {
	/bin/bash --norc --noprofile
}

do_shutdown() {
	shutdown -h now
}

do_reboot() {
	reboot
}

while true; do
	action="$(tui_main_menu)"
	case $? in
		"$TUI_OK") "do_${action}";;
		*);;
	esac
done
